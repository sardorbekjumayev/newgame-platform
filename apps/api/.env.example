NODE_ENV=development
PORT=4900
DATABASE_URL=postgresql://ng:ng@localhost:55444/newgame?schema=public
REDIS_URL=redis://localhost:56390
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
CORS_ORIGINS=http://localhost:4910,http://localhost:4920
APP_TIMEZONE_DEFAULT=Asia/Tashkent
SUPER_ADMIN_EMAIL=admin@newgame.local
SUPER_ADMIN_PASSWORD=ChangeMe123!

# Telegram bot (login kodi shu bot orqali). @BotFather'dan token oling. Bo'sh bo'lsa dev'da kod 000000.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MODE=polling
# Prod (TELEGRAM_MODE=webhook): https://<api-domen>/api/v1/telegram/webhook
TELEGRAM_WEBHOOK_URL=
# Telegram Mini App manzili (faqat https): bot menyusi → <url>/tg
TELEGRAM_WEBAPP_URL=
TELEGRAM_WEBHOOK_SECRET=

# Rate limit: <so'rov soni>/<oyna, soniya>. Bo'sh — standart.
RATE_LIMIT_GLOBAL=300/60
RATE_LIMIT_PUBLIC=120/60
RATE_LIMIT_WRITE=30/60
RATE_LIMIT_SENSITIVE=20/300

# Yandex HTTP Geocoder (klub joyi qidiruvi). Faqat serverda.
YANDEX_GEOCODER_KEY=

# Yuklangan fayllar (klub logotipi va rasmi). Bo'sh — ./storage (apps/api/storage, git'da yo'q).
# Prod: doimiy papka (masalan /var/lib/zonup/storage) — deploy'da o'chib ketmasin.
STORAGE_DIR=
