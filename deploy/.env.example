# Zonup production — deploy/docker-compose.yml shu faylni o'qiydi. Nusxa: cp .env.example .env
# Sirlar git'ga tushmaydi (.gitignore → .env).

# ---- Domenlar (brauzerga chiqadi, image build paytida yoziladi — o'zgarsa: docker compose build) ----
SITE_URL=https://zonup.uz
PANEL_URL=https://admin.zonup.uz
YANDEX_MAPS_KEY=
GA_ID=

# ---- Docker xizmatlari ----
# openssl rand -hex 24
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Klub logotipi/rasmlari (zaxira nusxaga kiriting)
STORAGE_PATH=/var/lib/zonup/storage

# ---- API (apps/api) ----
DATABASE_URL=postgresql://zonup:<POSTGRES_PASSWORD>@127.0.0.1:55445/zonup?schema=public
REDIS_URL=redis://:<REDIS_PASSWORD>@127.0.0.1:56391
# openssl rand -hex 48 (har biri alohida)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CORS_ORIGINS=https://zonup.uz,https://admin.zonup.uz
APP_TIMEZONE_DEFAULT=Asia/Tashkent
PUBLIC_WEB_URL=https://zonup.uz

# Faqat birinchi seed uchun (login: admin yoki shu email). Kirgach parolni almashtiring.
SUPER_ADMIN_EMAIL=admin@zonup.uz
SUPER_ADMIN_PASSWORD=

# Telegram bot (production'da majburiy — tokensiz mijozlar kira olmaydi)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBAPP_URL=https://zonup.uz

YANDEX_GEOCODER_KEY=

RATE_LIMIT_GLOBAL=300/60
RATE_LIMIT_PUBLIC=120/60
RATE_LIMIT_WRITE=30/60
RATE_LIMIT_SENSITIVE=20/300
